<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= variant === 'account' ? 'Account Verification Required' : 'Claim Your Reward' %></title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="card">
    <span class="badge urgent">ACTION REQUIRED</span>
    <% if (variant === 'account') { %>
      <h1>Security Alert: Verify Your Identity</h1>
      <p class="muted">Unusual activity was detected on this access point. Verify your details immediately to continue, or your session will be locked.</p>
    <% } else { %>
      <h1>Congratulations! You've Unlocked a Bonus Reward</h1>
      <p class="muted">Enter your details below right now to claim this exclusive prize before it expires.</p>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <form method="POST" action="/q/<%= slug %>/submit">
      <label for="teamName">Team Name</label>
      <input type="text" id="teamName" name="teamName" value="<%= typeof teamName !== 'undefined' ? teamName : '' %>" required />

      <label for="playerName">Your Name</label>
      <input type="text" id="playerName" name="playerName" value="<%= typeof playerName !== 'undefined' ? playerName : '' %>" required />

      <label for="email">SLB Email</label>
      <input type="email" id="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" placeholder="you@slb.com" required />

      <button type="submit" class="danger">
        <%= variant === 'account' ? 'Verify Now' : 'Claim Reward' %>
      </button>
    </form>
  </div>
</body>
</html>
