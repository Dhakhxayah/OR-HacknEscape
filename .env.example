# Port the server listens on (Render sets this automatically in production)
PORT=3000

# Public base URL of the deployed site, no trailing slash.
# Used only by scripts/generate-qrcodes.js to build the QR code URLs.
# Example once deployed on Render: https://hacknescape-slb.onrender.com
BASE_URL=http://localhost:3000

# Password for the /admin dashboard. Change this before the event.
ADMIN_PASSWORD=change-me-before-event

# Secret used to sign the admin session cookie. Any long random string.
SESSION_SECRET=change-me-too-long-random-string

# Email domain required for a decoy-click submission to be accepted.
ALLOWED_EMAIL_DOMAIN=slb.com

# Path to the SQLite database file.
DB_PATH=./data.db
